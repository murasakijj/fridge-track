# ローカル開発用。Firebase は household-chore-manager と同じ「共有プロジェクト」を使う。
# 値は共有プロジェクトの Firebase Console > プロジェクトの設定 > 全般 > マイアプリ にある
# Web アプリ設定から取得(このアプリ用に Web アプリを追加登録する必要はない)。
# .env.local にコピーして値を埋める(.env.local はgit管理外)。
# これらはブラウザに公開される値(公開設定値。秘密情報ではない)。
# 切り替え手順: household-chore-manager の docs/firebase-consolidation.md を参照。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- サーバー側(Vercel Functions)専用。ローカルでは vercel dev 使用時のみ必要 ---
# Vercelダッシュボードの環境変数として設定し、.envファイルには書かないこと。
# 秘密情報に VITE_ を付けない(ブラウザに公開されてしまう)。

# 認証(必須)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # 1 行 JSON。共有プロジェクトのサービスアカウント(旧プロジェクトのものは使わない)
# ALLOWED_EMAILS=you@example.com                             # カンマ区切り。本人のみ

# レシート解析の生成 AI(既定は gemini)
# AI_PROVIDER=gemini            # gemini | openai | anthropic
# AI_MODEL=gemini-3.6-flash     # 省略時は gemini/anthropic の既定モデル。openai は必須(画像入力対応モデル)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_BASE_URL=                  # OpenAI 互換サーバー等を使う場合のみ(例: http://localhost:11434/v1)

# レシピアプリ連携(任意。両方そろったときだけ連携トークン認証が有効)
# RECIPE_INTEGRATION_TOKEN=     # 32 文字以上のランダム文字列
# INVENTORY_OWNER_UID=          # 在庫データの持ち主の Firebase uid。共有プロジェクトでの uid
#                               # (共有プロジェクトの Firebase コンソール > Authentication > ユーザー の User UID。
#                               #  家事アプリでログイン済みのアカウント。uid は全アプリ共通。旧プロジェクトの uid のままだと連携が動かない)
